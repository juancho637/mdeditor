# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=markdown
DATABASE_PASSWORD=markdown_secret
DATABASE_NAME=markdown

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate Limiting
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_TTL=60000
THROTTLE_LOGIN_LIMIT=5

# API
API_PORT=3000
