# API URL — used by browser for HTTP requests
# Docker: http://api:3000 | Production: https://your-domain.com
NEXT_PUBLIC_API_URL=http://api:3000

# WebSocket URL — used by browser for real-time collaboration
# Docker: ws://api:3000 | Production: wss://your-domain.com
NEXT_PUBLIC_WS_URL=ws://api:3000
