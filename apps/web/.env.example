# API URL (used by the browser to connect to the backend)
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket URL (used by the browser for real-time collaboration)
# In Docker: ws://localhost:3000 | Production: wss://your-domain.com
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Internal API URL (used by Next.js middleware server-side, inside Docker network)
# In Docker: http://api:3000 | Local: http://localhost:3000
API_INTERNAL_URL=http://localhost:3000
